#!/usr/bin/env python3
import json
import os
import shutil
import subprocess
import sys

MAX_OUTPUT = 2 * 1024 * 1024
TIMEOUT_SECONDS = 12
PLATFORMS = ("telegram", "whatsapp", "signal", "discord", "matrix")


def emit(value, status=0):
    print(json.dumps(value, ensure_ascii=True, separators=(",", ":")))
    return status


def run_bridge(arguments, payload=None):
    executable = shutil.which("kairos-social-bridge")
    if not executable:
        return None, "No compatible kairos-social-bridge executable was found."
    try:
        result = subprocess.run(
            [executable] + arguments,
            input=payload,
            stdout=subprocess.PIPE,
            stderr=subprocess.DEVNULL,
            text=True,
            timeout=TIMEOUT_SECONDS,
            check=False,
            close_fds=True,
        )
    except (OSError, subprocess.TimeoutExpired):
        return None, "The local social bridge could not be reached."
    if len(result.stdout.encode("utf-8", "replace")) > MAX_OUTPUT:
        return None, "The local social bridge returned too much data."
    if result.returncode != 0:
        return None, "The local social bridge reported an error."
    try:
        value = json.loads(result.stdout)
    except (TypeError, ValueError):
        return None, "The local social bridge returned invalid JSON."
    return value, ""


def main(argv):
    if len(argv) < 1:
        return emit({"ok": False, "available": False, "error": "A bridge operation is required."}, 2)
    operation = argv[0]
    if operation not in ("capabilities", "snapshot", "send", "call", "mark-read"):
        return emit({"ok": False, "error": "Unsupported bridge operation."}, 2)
    payload_text = sys.stdin.read(200000) if operation in ("send", "call", "mark-read") else None
    if operation == "capabilities":
        value, error = run_bridge(["capabilities", "--json"])
        if error:
            return emit({"ok": False, "available": False, "platforms": {}, "accounts": [], "error": error})
        raw = value.get("platforms", {}) if isinstance(value, dict) else {}
        platforms = {}
        for platform in PLATFORMS:
            entry = raw.get(platform, False) if isinstance(raw, dict) else False
            available = entry.get("available") is True if isinstance(entry, dict) else entry is True
            platforms[platform] = {"available": available}
        accounts = value.get("accounts", []) if isinstance(value, dict) else []
        if not isinstance(accounts, list): accounts = []
        accounts = [item for item in accounts[:100] if isinstance(item, dict)
                    and item.get("platform") in PLATFORMS]
        return emit({"ok": True, "available": True, "platforms": platforms, "accounts": accounts})
    if operation == "snapshot":
        value, error = run_bridge(["snapshot", "--json"])
        if error:
            return emit({"ok": False, "available": False, "events": [], "accounts": [], "error": error})
        if not isinstance(value, dict) or not isinstance(value.get("events", []), list):
            return emit({"ok": False, "available": True, "events": [], "accounts": [],
                         "error": "The local social bridge returned an invalid snapshot."})
        events = [item for item in value.get("events", [])[:1000]
                  if isinstance(item, dict) and item.get("platform") in PLATFORMS]
        accounts = [item for item in value.get("accounts", [])[:100]
                    if isinstance(item, dict) and item.get("platform") in PLATFORMS]
        return emit({"ok": True, "available": True, "events": events, "accounts": accounts})
    if operation == "send":
        if len(argv) != 4:
            return emit({"ok": False, "error": "A platform, account ID, and chat ID are required."}, 2)
        try:
            payload = json.loads(payload_text or "{}")
        except ValueError:
            return emit({"ok": False, "error": "The message payload is invalid."}, 2)
        if not isinstance(payload, dict) or not isinstance(payload.get("text"), str):
            return emit({"ok": False, "error": "The message text is required."}, 2)
        args = ["send", "--json", "--platform", argv[1], "--account-id", argv[2], "--chat-id", argv[3]]
        value, error = run_bridge(args, json.dumps(payload, ensure_ascii=True))
    elif operation == "call":
        if len(argv) != 4 or argv[1] not in ("answer", "decline"):
            return emit({"ok": False, "error": "A call action, platform, and call ID are required."}, 2)
        args = ["call", argv[1], "--platform", argv[2], "--call-id", argv[3]]
        value, error = run_bridge(args)
    else:
        if len(argv) != 4:
            return emit({"ok": False, "error": "A platform, account ID, and chat ID are required."}, 2)
        args = ["mark-read", "--platform", argv[1], "--account-id", argv[2], "--chat-id", argv[3]]
        value, error = run_bridge(args)
    if error:
        return emit({"ok": False, "error": error}, 1)
    if not isinstance(value, dict) or value.get("ok") is not True:
        message = value.get("error") if isinstance(value, dict) else ""
        return emit({"ok": False, "error": str(message or "The local social bridge rejected the action.")}, 1)
    return emit({"ok": True, "result": value})


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
