#!/usr/bin/env python3
import re
import sys
import urllib.parse

from _secure_fetch import SafeFetchError, emit, fetch_json, now_ms, read_cache, write_cache

CACHE_NAME = "crypto.json"
TTL_MS = 10 * 60 * 1000
DEFAULT_IDS = [
    "bitcoin", "ethereum", "solana", "binancecoin", "ripple", "cardano", "dogecoin",
    "tron", "the-open-network", "avalanche-2", "polkadot", "chainlink", "shiba-inu",
    "bitcoin-cash", "litecoin"
]


def safe_ids(value):
    if not isinstance(value, (list, tuple)):
        return []
    output = []
    for item in value:
        coin_id = str(item).strip().lower()
        if re.fullmatch(r"[a-z0-9-]{1,64}", coin_id) and coin_id not in output:
            output.append(coin_id)
        if len(output) >= 50:
            break
    return output


def validated_prices(value):
    if not isinstance(value, dict) or len(value) > 50:
        return None
    output = {}
    for key, raw in value.items():
        coin_id = str(key).lower()
        if not re.fullmatch(r"[a-z0-9-]{1,64}", coin_id):
            continue
        raw_value = raw.get("usd") if isinstance(raw, dict) else raw
        if isinstance(raw_value, bool):
            continue
        try:
            price = float(raw_value)
        except (TypeError, ValueError, OverflowError):
            continue
        if price <= 0 or price > 1e18 or price != price or price == float("inf"):
            continue
        output[coin_id] = price
    return output if output else None


def valid_cache(data):
    if not isinstance(data, dict) or type(data.get("version")) is not int or data.get("version") != 1:
        return None
    fetched_at = data.get("fetched_at")
    if isinstance(fetched_at, bool) or not isinstance(fetched_at, (int, float)):
        return None
    fetched_at = int(fetched_at)
    if fetched_at <= 0 or fetched_at > now_ms() + 300000:
        return None
    prices = validated_prices(data.get("prices"))
    if prices is None:
        return None
    return {"version": 1, "fetched_at": fetched_at, "prices": prices}


def main(argv):
    args = list(argv)
    force = "--force" in args
    args = [item for item in args if item != "--force"]
    requested = safe_ids(args[0].split(",")) if args else DEFAULT_IDS[:]
    if not requested:
        requested = DEFAULT_IDS[:]
    if len(requested) > 50:
        requested = requested[:50]

    now = now_ms()
    cached = valid_cache(read_cache(CACHE_NAME))
    cache_has_all = cached and all(coin_id in cached["prices"] for coin_id in requested)
    if cache_has_all and not force and now - cached["fetched_at"] <= TTL_MS:
        prices = {coin_id: cached["prices"][coin_id] for coin_id in requested}
        emit({"ok": True, "prices": prices, "fetched_at": cached["fetched_at"], "stale": False})
        return 0

    query = urllib.parse.urlencode({"ids": ",".join(requested), "vs_currencies": "usd"})
    url = "https://api.coingecko.com/api/v3/simple/price?" + query
    try:
        response = fetch_json(url, "api.coingecko.com", timeout=8)
        if not isinstance(response, dict):
            raise SafeFetchError("crypto-price provider returned an invalid response")
        prices = validated_prices(response)
        if prices is None:
            raise SafeFetchError("crypto-price provider returned invalid prices")
        # The converter uses a fixed, bounded list of requested CoinGecko IDs.
        prices = {coin_id: prices[coin_id] for coin_id in requested if coin_id in prices}
        if not prices:
            raise SafeFetchError("crypto-price provider returned no requested coins")
        fetched_at = now_ms()
        cache = {"version": 1, "fetched_at": fetched_at, "prices": prices}
        try:
            write_cache(CACHE_NAME, cache)
        except (OSError, SafeFetchError):
            pass
        emit({"ok": True, "prices": prices, "fetched_at": fetched_at, "stale": False})
        return 0
    except Exception:
        if cached:
            prices = {coin_id: cached["prices"][coin_id] for coin_id in requested if coin_id in cached["prices"]}
            if prices:
                emit({"ok": True, "prices": prices, "fetched_at": cached["fetched_at"], "stale": True})
                return 0
        emit({"ok": False, "error": "Crypto conversion rates are unavailable; check your network connection."})
        return 1


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
